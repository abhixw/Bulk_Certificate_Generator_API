# ── Application ────────────────────────────────────────────────────────────────
# Primary PostgreSQL connection string.
# For local development: postgresql+psycopg://user:password@localhost:5432/certdb
# For production (Neon): postgresql+psycopg://user:password@ep-xxx.neon.tech/certdb?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/certdb

# Absolute or relative path where generated PDFs will be stored.
# Relative paths are resolved from the project root.
GENERATED_FILES_DIR=generated

# ── Optional ───────────────────────────────────────────────────────────────────
# Controls uvicorn log level: debug | info | warning | error | critical
LOG_LEVEL=info
