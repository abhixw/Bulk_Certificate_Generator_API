# ── Secrets — NEVER commit these ───────────────────────────────────────────────
.env

# ── Python ─────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ── Virtual environments ────────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Distribution / packaging ────────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg

# ── Testing & coverage ──────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
*.xml

# ── Generated PDFs (runtime output) ────────────────────────────────────────────
# Keep the directory in Git, exclude its runtime contents.
generated/*
!generated/.gitkeep

# ── IDE / OS ────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Docker ─────────────────────────────────────────────────────────────────────
# Local override files (e.g. docker-compose.override.yml with dev secrets)
docker-compose.override.yml

# ── Alembic auto-generated SQL ─────────────────────────────────────────────────
*.sql
